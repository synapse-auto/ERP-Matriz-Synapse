    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst headers = $json.headers ?? {};\nconst token = headers['x-synapse-token'] ?? headers['X-Synapse-Token'];\nconst idempotencyKey = headers['idempotency-key'] ?? headers['Idempotency-Key'];\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst dataValida = typeof body.solicitadoEm === 'string' && Number.isFinite(Date.parse(body.solicitadoEm));\nif (token !== $env.AUTOMACAO_TOKEN) return [{ json: { httpStatus: 401, erro: 'UNAUTHORIZED' } }];\nif (body.evento !== 'RESUMO_IA_SOLICITADO' || !uuid.test(body.solicitacaoId) || !uuid.test(body.leadId) || !uuid.test(body.atendimentoId) || !dataValida || idempotencyKey !== body.solicitacaoId) return [{ json: { httpStatus: 400, erro: 'PAYLOAD_INVALIDO' } }];\nreturn [{ json: { httpStatus: 202, evento: body.evento, solicitacaoId: body.solicitacaoId, leadId: body.leadId, atendimentoId: body.atendimentoId, solicitadoEm: body.solicitadoEm } }];"
      },
      "id": "1f9f3a1d-1f0d-4c0f-b2e6-6c4d6d04d002",
      "name": "Validar contrato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
