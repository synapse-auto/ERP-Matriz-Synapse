        "dataTableId": { "__rl": true, "mode": "id", "value": "CONFIGURE_DATA_TABLE_ID" },
        "matchType": "all",
        "filters": { "conditions": [{ "keyName": "solicitacaoId", "condition": "eq", "keyValue": "={{$json.solicitacaoId}}" }] },
