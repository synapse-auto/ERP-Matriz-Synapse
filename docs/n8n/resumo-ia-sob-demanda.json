      "id": "1f9f3a1d-1f0d-4c0f-b2e6-6c4d6d04d003",
      "name": "Localizar chave idempotente",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "alwaysOutputData": true,
      "position": [660, 180]
    },
    {
      "parameters": {
        "jsCode": "const entrada = $('Validar contrato').item.json;\nconst existente = $json ?? {};\nif (!existente.solicitacaoId) return [{ json: { ...entrada, httpStatus: 202, idempotencia: 'NOVA' } }];\nconst mesmaIdentidade = existente.leadId === entrada.leadId && existente.atendimentoId === entrada.atendimentoId;\nif (!mesmaIdentidade) return [{ json: { ...entrada, httpStatus: 409, idempotencia: 'CONFLITO', erro: 'IDEMPOTENCY_CONFLICT' } }];\nreturn [{ json: { ...entrada, httpStatus: 200, idempotencia: 'REPLAY', status: existente.status } }];"
      },
      "id": "1f9f3a1d-1f0d-4c0f-b2e6-6c4d6d04d004",
      "name": "Classificar chave idempotente",
