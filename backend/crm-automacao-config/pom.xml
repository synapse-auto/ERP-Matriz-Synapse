<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.synapse.crm</groupId>
    <artifactId>synapse-crm-base</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>crm-automacao-config</artifactId>
  <name>Synapse CRM :: Automacao Config</name>
  <description>Parametros da automacao e feature flags.</description>

  <!--
    Spring e JPA entram aqui porque as camadas infrastructure e interfaces
    precisam deles. O pacote domain continua proibido de importa-los — isso
    nao da para expressar no POM, entao e verificado pelo teste de arquitetura
    ArquiteturaTest (crm-app), que falha o build em caso de violacao.
  -->
  <dependencies>
    <dependency>
      <groupId>com.synapse.crm</groupId>
      <artifactId>crm-shared-kernel</artifactId>
    </dependency>
    <!--
      So para CanalGateway.exigeTemplateForaDaJanela() (E07 §5): o contrato da
      Automacao expoe a capacidade do canal ativo, e quem sabe disso e o
      adaptador de canal, em crm-atendimento. Precedente: crm-atendimento ja
      depende de crm-equipe (E06) pelo mesmo motivo — modulos-irmao podem
      depender um do outro quando a necessidade e real, desde que sem ciclo.
    -->
    <dependency>
      <groupId>com.synapse.crm</groupId>
      <artifactId>crm-atendimento</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
