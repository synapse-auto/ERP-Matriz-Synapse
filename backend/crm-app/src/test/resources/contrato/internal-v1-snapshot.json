{
  "paths" : {
    "/internal/v1/atendimentos/{id}/mensagens-enviadas" : {
      "post" : {
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MensagemEnviadaRequisicao"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MensagemEnviadaResposta"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "description" : "Mensagem normalizada inválida."
          },
          "401" : {
            "description" : "Credencial ausente, inválida ou expirada."
          },
          "403" : {
            "description" : "Credencial válida sem permissão para a operação."
          },
          "404" : {
            "description" : "Atendimento inexistente."
          },
          "409" : {
            "description" : "wamid já pertence a outro atendimento."
          }
        }
      }
    },
    "/internal/v1/atendimentos/{id}/transferir" : {
      "post" : {
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransferenciaResposta"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          },
          "404" : {
            "description" : "Atendimento inexistente."
          },
          "409" : {
            "description" : "Transferencia indisponivel."
          }
        }
      }
    },
    "/internal/v1/atendentes/disponiveis" : {
      "get" : {
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/AtendenteResposta"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          }
        }
      }
    },
    "/internal/v1/automation-config" : {
      "get" : {
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AutomationConfigResposta"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          }
        }
      }
    },
    "/internal/v1/automation-config/{chave}" : {
      "get" : {
        "parameters" : [ {
          "in" : "path",
          "name" : "chave",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ParametroResposta"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          },
          "404" : {
            "description" : "Chave nao encontrada."
          }
        }
      }
    },
    "/internal/v1/eventos" : {
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EventoRequisicao"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          }
        }
      }
    },
    "/internal/v1/regras/fidelizacao" : {
      "get" : {
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/RegraFidelizacaoResposta"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          }
        }
      }
    },
    "/internal/v1/regras/follow-up" : {
      "get" : {
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/RegraFollowUpResposta"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "Credencial ausente, invalida ou expirada."
          },
          "403" : {
            "description" : "Credencial valida sem permissao para a operacao."
          }
        }
      }
    }
  },
  "schemas" : {
    "AtendenteResposta" : {
      "properties" : {
        "email" : {
          "type" : "string"
        },
        "nome" : {
          "type" : "string"
        },
        "usuarioId" : {
          "format" : "uuid",
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "AutomationConfigResposta" : {
      "properties" : {
        "exigeTemplateForaDaJanela" : {
          "type" : "boolean"
        },
        "parametros" : {
          "items" : {
            "$ref" : "#/components/schemas/ParametroResposta"
          },
          "type" : "array"
        }
      },
      "type" : "object"
    },
    "EventoRequisicao" : {
      "properties" : {
        "tipo" : {
          "enum" : [ "MENSAGEM_ENVIADA", "CLIENTE_TRANSFERIDO" ],
          "type" : "string"
        }
      },
      "required" : [ "tipo" ],
      "type" : "object"
    },
    "ParametroResposta" : {
      "properties" : {
        "atualizadoEm" : {
          "format" : "date-time",
          "type" : "string"
        },
        "chave" : {
          "type" : "string"
        },
        "descricao" : {
          "type" : "string"
        },
        "tipo" : {
          "enum" : [ "INT", "DECIMAL", "BOOLEAN", "TEXT" ],
          "type" : "string"
        },
        "unidade" : {
          "type" : "string"
        },
        "valor" : {
          "type" : "string"
        },
        "valorMax" : {
          "type" : "number"
        },
        "valorMin" : {
          "type" : "number"
        }
      },
      "type" : "object"
    },
    "MensagemEnviadaResposta" : {
      "properties" : {
        "atendimentoId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "enviadoEm" : {
          "format" : "date-time",
          "type" : "string"
        },
        "idempotente" : {
          "type" : "boolean"
        },
        "mensagemId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "statusEntrega" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "RegraFidelizacaoResposta" : {
      "properties" : {
        "diasSemContato" : {
          "format" : "int32",
          "type" : "integer"
        },
        "id" : {
          "format" : "uuid",
          "type" : "string"
        },
        "mensagem" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "RegraFollowUpResposta" : {
      "properties" : {
        "id" : {
          "format" : "uuid",
          "type" : "string"
        },
        "nome" : {
          "type" : "string"
        },
        "tempoMinutos" : {
          "format" : "int32",
          "type" : "integer"
        },
        "texto" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "MensagemEnviadaRequisicao" : {
      "properties" : {
        "conteudo" : {
          "type" : "string"
        },
        "midiaMetadados" : {
          "type" : "string"
        },
        "midiaUrl" : {
          "type" : "string"
        },
        "tipo" : {
          "enum" : [ "TEXTO", "AUDIO", "IMAGEM", "DOCUMENTO" ],
          "type" : "string"
        },
        "wamid" : {
          "type" : "string"
        }
      },
      "required" : [ "tipo", "wamid" ],
      "type" : "object"
    },
    "TransferenciaResposta" : {
      "properties" : {
        "atendenteId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "atendimentoId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "status" : {
          "type" : "string"
        }
      },
      "type" : "object"
    }
  }
}
