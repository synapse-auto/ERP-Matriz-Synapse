{
  "paths" : {
    "/internal/v1/atendimentos/{id}/responder" : {
      "post" : {
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResponderRequisicao"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RespostaComandoAutomacao"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "description" : "Conteúdo ou Idempotency-Key ausente."
          },
          "401" : {
            "description" : "Credencial ausente, inválida ou expirada."
          },
          "403" : {
            "description" : "Credencial válida sem permissão para a operação."
          },
          "404" : {
            "description" : "Atendimento inexistente."
          },
          "409" : {
            "description" : "Atendimento não está sob responsabilidade da IA ou chave reutilizada."
          },
          "422" : {
            "description" : "Canal fora da janela de texto livre."
          }
        }
      }
    },
