        },
        "tipoMidia" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "RespostaComandoAutomacao" : {
      "properties" : {
        "atendimentoId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "enviadoEm" : {
          "format" : "date-time",
          "type" : "string"
        },
        "mensagemId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "statusEntrega" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "ResponderRequisicao" : {
      "properties" : {
        "conteudo" : {
          "example" : "Posso ajudar com seu orçamento?",
          "minLength" : 1,
          "type" : "string"
        }
      },
      "required" : [ "conteudo" ],
      "type" : "object"
    },
    "TransferirRequisicao" : {
      "properties" : {
        "atendenteId" : {
          "format" : "uuid",
          "type" : "string"
        }
      },
      "required" : [ "atendenteId" ],
      "type" : "object"
    },
    "AtendenteResposta" : {
      "properties" : {
        "email" : {
          "type" : "string"
        },
        "nome" : {
          "type" : "string"
        },
        "usuarioId" : {
          "format" : "uuid",
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "AutomationConfigResposta" : {
      "properties" : {
        "exigeTemplateForaDaJanela" : {
          "type" : "boolean"
        },
        "parametros" : {
          "items" : {
            "$ref" : "#/components/schemas/ParametroResposta"
          },
          "type" : "array"
        }
      },
      "type" : "object"
    },
    "EventoRequisicao" : {
      "properties" : {
        "tipo" : {
          "enum" : [ "MENSAGEM_ENVIADA", "CLIENTE_TRANSFERIDO" ],
          "type" : "string"
        }
      },
      "required" : [ "tipo" ],
      "type" : "object"
    },
    "ParametroResposta" : {
      "properties" : {
        "atualizadoEm" : {
          "format" : "date-time",
          "type" : "string"
        },
        "chave" : {
          "type" : "string"
        },
        "descricao" : {
          "type" : "string"
        },
        "tipo" : {
          "enum" : [ "INT", "DECIMAL", "BOOLEAN", "TEXT" ],
          "type" : "string"
        },
        "unidade" : {
          "type" : "string"
        },
        "valor" : {
          "type" : "string"
        },
        "valorMax" : {
          "type" : "number"
        },
        "valorMin" : {
          "type" : "number"
        }
      },
      "type" : "object"
    },
    "MensagemEnviadaResposta" : {
      "properties" : {
        "atendimentoId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "enviadoEm" : {
          "format" : "date-time",
          "type" : "string"
        },
        "idempotente" : {
          "type" : "boolean"
        },
        "mensagemId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "statusEntrega" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "RegraFidelizacaoResposta" : {
      "properties" : {
        "diasSemContato" : {
          "format" : "int32",
          "type" : "integer"
        },
        "id" : {
          "format" : "uuid",
          "type" : "string"
        },
        "mensagem" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
    "RegraFollowUpResposta" : {
      "properties" : {
        "id" : {
          "format" : "uuid",
          "type" : "string"
        },
        "nome" : {
          "type" : "string"
        },
        "tempoMinutos" : {
          "format" : "int32",
          "type" : "integer"
        },
        "texto" : {
          "type" : "string"
        }
      },
      "type" : "object"
    },
      "MensagemEnviadaRequisicao" : {
        "properties" : {
          "conteudo" : {
            "type" : "string"
          },
          "midiaMetadados" : {
            "type" : "string"
          },
          "midiaUrl" : {
            "type" : "string"
          },
          "opcoes" : {
            "type" : "string"
          },
          "tipo" : {
            "enum" : [ "TEXTO", "AUDIO", "IMAGEM", "DOCUMENTO", "BOTOES", "LISTA" ],
            "type" : "string"
          },
          "wamid" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "tipo", "wamid" ],
        "type" : "object"
      },
    "TransferenciaResposta" : {
      "properties" : {
        "atendenteId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "atendimentoId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "status" : {
          "type" : "string"
        }
      },
      "type" : "object"
    }
  }
