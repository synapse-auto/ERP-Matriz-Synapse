  "schemas" : {
    "ModoIaRequisicao" : {
      "type" : "object"
    },
    "Resposta" : {
      "properties" : {
        "atendenteId" : {
          "format" : "uuid",
          "type" : "string"
        },
        "atendenteNome" : {
          "type" : "string"
        },
        "conteudo" : {
          "type" : "string"
        },
        "id" : {
          "format" : "uuid",
          "type" : "string"
        },
        "palavraChave" : {
