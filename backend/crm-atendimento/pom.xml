<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.synapse.crm</groupId>
    <artifactId>synapse-crm-base</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>crm-atendimento</artifactId>
  <name>Synapse CRM :: Atendimento</name>
  <description>Atendimento, Mensagem, Canal e gateway WebSocket.</description>

  <!--
    Spring e JPA entram aqui porque as camadas infrastructure e interfaces
    precisam deles. O pacote domain continua proibido de importa-los — isso
    nao da para expressar no POM, entao e verificado pelo teste de arquitetura
    ArquiteturaTest (crm-app), que falha o build em caso de violacao.
  -->
  <dependencies>
    <dependency>
      <groupId>com.synapse.crm</groupId>
      <artifactId>crm-shared-kernel</artifactId>
    </dependency>

    <!--
      Atendimento e sempre atendimento DE UM LEAD: o agregado referencia lead_id, e
      o caminho critico atualiza contadores e ultima_interacao_em pela porta
      LeadNoCaminhoDeMensagem. A dependencia e de mao unica — crm-core nao conhece
      crm-atendimento — entao nao ha ciclo entre os modulos.
    -->
    <dependency>
      <groupId>com.synapse.crm</groupId>
      <artifactId>crm-core</artifactId>
    </dependency>

    <!--
      O WebSocket (E06) precisa de SecurityContextPropagationInterceptor, que
      toca SecurityContextHolder — e a regra de arquitetura reserva esse toque
      ao pacote seguranca de crm-equipe (ArquiteturaTest,
      contexto_de_seguranca_so_no_adaptador). crm-equipe nao depende de
      crm-atendimento, entao a aresta e de mao unica e nao cria ciclo.
    -->
    <dependency>
      <groupId>com.synapse.crm</groupId>
      <artifactId>crm-equipe</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>

    <!--
      Circuit breaker de toda chamada de saida do canal (CLAUDE.md). Sem ele, um
      provedor lento vira fila de threads presas no caminho critico.
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!--
      STOMP sobre WebSocket para o chat em tempo real (E06). O caminho HTTP
      continua sendo o de escrita (RN-CRM-06, outbox); o WebSocket so entrega
      o que ja foi persistido — nunca a unica copia de um fato.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!--
      Backplane pub/sub entre instancias (E06). Sem ele, dois atendentes em
      instancias diferentes da mesma aplicacao nao se enxergam — o WebSocket
      sozinho so alcanca quem esta conectado NAQUELA instancia.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Storage de midia do chat (E11b). MinIO em dev, S3-compativel em producao —
      mesmo cliente para os dois, so muda endpoint/credenciais (docs/01, docs/09).
    -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!--
      Deteccao de tipo real por magic bytes: so o core, sem parsers de conteudo
      (nao precisamos extrair texto de PDF, so identificar o mimetype real).
    -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
    </dependency>
  </dependencies>
</project>
