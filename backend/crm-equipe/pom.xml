<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.synapse.crm</groupId>
    <artifactId>synapse-crm-base</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>crm-equipe</artifactId>
  <name>Synapse CRM :: Equipe</name>
  <description>Usuarios, papeis, presenca e horarios.</description>

  <!--
    Spring e JPA entram aqui porque as camadas infrastructure e interfaces
    precisam deles. O pacote domain continua proibido de importa-los — isso
    nao da para expressar no POM, entao e verificado pelo teste de arquitetura
    ArquiteturaTest (crm-app), que falha o build em caso de violacao.
  -->
  <dependencies>
    <dependency>
      <groupId>com.synapse.crm</groupId>
      <artifactId>crm-shared-kernel</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- @PreAuthorize por caso de uso e leitura do JWT da requisicao. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!--
      Traz spring-messaging: SecurityContextPropagationInterceptor (E06) e um
      ChannelInterceptor do canal STOMP do WebSocket de crm-atendimento. Mora
      aqui porque toca SecurityContextHolder, e a regra de arquitetura reserva
      esse toque a este pacote.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
