<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.synapse.crm</groupId>
    <artifactId>synapse-crm-base</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>crm-shared-kernel</artifactId>
  <name>Synapse CRM :: Shared Kernel</name>
  <description>Value objects e tipos base compartilhados. Java puro, sem framework.</description>

  <!--
    Este modulo NAO tem dependencias de producao, e isso e intencional.
    O enforcer abaixo faz disso uma regra de build: qualquer tentativa de
    adicionar Spring, JPA, Hibernate ou Jackson aqui quebra o `mvn install`.
  -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>proibir-framework-no-shared-kernel</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <message>
                    crm-shared-kernel deve permanecer Java puro. Nenhuma dependencia
                    de Spring, JPA, Hibernate ou Jackson pode entrar aqui — ver CLAUDE.md,
                    secao "Regra de dependencia".
                  </message>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework.data:*</exclude>
                    <exclude>org.springframework.security:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.hibernate:*</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
