# ---------------------------------------------------------------------------
# Copie para .env e ajuste. O .env NAO vai para o versionamento.
#
#   cp .env.example .env
#
# Tudo aqui tem default de desenvolvimento no application.yml / docker-compose.
# O que nao tem default sao os SEGREDOS: sem eles a funcionalidade que depende
# do segredo falha, em vez de rodar com credencial de outro ambiente.
# ---------------------------------------------------------------------------

# --- Identidade da instancia (o "filho") -----------------------------------
SYNAPSE_TENANT_CODIGO=estrutural-vidros
SYNAPSE_TENANT_NOME=Estrutural Vidros
SYNAPSE_TIMEZONE=America/Sao_Paulo

# --- Aplicacao --------------------------------------------------------------
SERVER_PORT=8080

# --- Banco ------------------------------------------------------------------
# Usado pela aplicacao (JDBC):
SYNAPSE_DB_URL=jdbc:postgresql://localhost:5432/synapse_crm
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapse

# Bulkhead — dois pools sobre o mesmo banco. O pool do chat existe para que um
# relatorio pesado nunca segure as conexoes do caminho de mensagens.
SYNAPSE_DB_POOL_GERAL_MAX=12
SYNAPSE_DB_POOL_GERAL_MIN=2
SYNAPSE_DB_POOL_GERAL_TIMEOUT_MS=30000
SYNAPSE_DB_POOL_CHAT_MAX=8
SYNAPSE_DB_POOL_CHAT_MIN=4
SYNAPSE_DB_POOL_CHAT_TIMEOUT_MS=3000

# Usado pelo docker-compose (mesmo banco, outra sintaxe):
POSTGRES_DB=synapse_crm
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_PORT=5432

# --- Redis e RabbitMQ (consumidos a partir da E06/E07) ----------------------
REDIS_PORT=6379
RABBITMQ_USER=synapse
RABBITMQ_PASSWORD=synapse
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Storage de midia do chat (E11b) -----------------------------------------
# Usado pela aplicacao: endpoint e o que o BACKEND alcanca (hostname interno do
# Docker se o backend tambem rodar em container; localhost se rodar no host,
# como os outros servicos deste compose). url-publica e o host embutido na URL
# assinada que vai para o browser — vazio cai para MIDIA_S3_ENDPOINT.
MIDIA_S3_ENDPOINT=http://localhost:9000
MIDIA_S3_URL_PUBLICA=
MIDIA_S3_BUCKET=synapse-crm-midia
MIDIA_S3_ACCESS_KEY=minioadmin
MIDIA_S3_SECRET_KEY=minioadmin
MIDIA_S3_EXPIRACAO_LEITURA=5m

# Usado pelo docker-compose (mesmo MinIO, outra sintaxe):
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Canal WhatsApp (E05) — SEGREDOS, deixe vazio se ainda nao tiver --------
WHATSAPP_PROVEDOR=
WHATSAPP_NUMERO=
TELEFONE_DDI_PADRAO=55
WHATSAPP_TOKEN=
# Token escolhido pela instancia para o desafio GET de cadastro do webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret da Meta, usado exclusivamente no HMAC X-Hub-Signature-256 dos POSTs.
WHATSAPP_WEBHOOK_SECRET=
# WABA ID. Necessario para listar/criar templates; nao e o Phone Number ID.
WHATSAPP_CONTA_NEGOCIO=

# --- Automacao (E07) — SEGREDOS ---------------------------------------------
AUTOMACAO_URL=
AUTOMACAO_TOKEN=
# Destino assíncrono do payload cru recebido da Meta. Vazio desabilita o repasse.
AUTOMACAO_WEBHOOK_EVENTOS_URL=https://n8n.187.77.47.30.sslip.io/webhook/estrutural-vidros/eventos

# E83: avaliacao apos finalizacao individual. Vazio = desligada, sem backlog retroativo.
# Segredo obtido do ambiente. Nao reutilizar nem copiar credenciais de conversas.
AUTOMACAO_AVALIACAO_URL=
AUTOMACAO_AVALIACAO_TOKEN=
AUTOMACAO_AVALIACAO_AUTH_HEADER=
AUTOMACAO_AVALIACAO_TIMEOUT=5s
AUTOMACAO_AVALIACAO_RESERVA_EXPIRACAO=30s
AUTOMACAO_AVALIACAO_LOTE=10
AUTOMACAO_AVALIACAO_CONCORRENCIA=2
AUTOMACAO_AVALIACAO_FILA=10
AUTOMACAO_AVALIACAO_MAXIMO_TENTATIVAS=5
AUTOMACAO_AVALIACAO_BACKOFF_INICIAL=10s
AUTOMACAO_AVALIACAO_BACKOFF_MAXIMO=30m
AUTOMACAO_AVALIACAO_MINIMO_CHAMADAS_CIRCUITO=5
AUTOMACAO_AVALIACAO_ESPERA_CIRCUITO=30s
AUTOMACAO_AVALIACAO_INTERVALO_MS=1000

# --- Alertas (E09) ----------------------------------------------------------
ALERTA_WEBHOOK=

# --- Seguranca (E02, E07 §1, E29) — SEGREDOS onde indicado ------------------
# Sem default de proposito: gerar com `openssl rand -base64 48`. Um default de
# desenvolvimento aqui e um cadeado que vem com a chave.
SYNAPSE_JWT_SEGREDO=
# Curto: um token vazado tem pouca janela de uso.
SYNAPSE_ACCESS_TOKEN_VALIDADE=15m
# Longo, mas revogavel e rotativo a cada uso.
SYNAPSE_REFRESH_TOKEN_VALIDADE=7d
# Lote maximo processado pelo scheduler de mensagens programadas.
MENSAGENS_PROGRAMADAS_LOTE=50
# Duracao do aviso visual de transferencia/devolucao (segundos).
ATENDIMENTOS_TEMPO_NOTIFICACAO_SEGUNDOS=8
# Segredo de X-Synapse-Token — o contrato que a Automacao de todo filho
# consome. Sem default: esquecer a variavel deixa /internal/v1 inutil, nunca
# aberta por acidente.
SYNAPSE_TOKEN_INTERNO=
AUTOMACAO_RESUMO_IA_TAMANHO_MAXIMO=8000
# E29: tamanho minimo de senha, exigido na troca, na criacao de usuario e na
# senha provisoria gerada pelo gestor. Nao e segredo.
SYNAPSE_SENHA_TAMANHO_MINIMO=8

# --- Frontend (E10) ----------------------------------------------------------
SYNAPSE_FRONTEND_ORIGEM=http://localhost:3000

# --- Feature flags de nivel 3 (arquivo da instancia) ------------------------
FEATURE_CAMPANHAS=true
FEATURE_CHAT_INTERNO=false
FEATURE_FIDELIZACAO=true
