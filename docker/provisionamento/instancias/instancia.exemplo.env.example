  {"chave":"followup.tentativas.maximo","valor":"3","unidade":"tentativas","tipo":"INT","valor_min":1,"valor_max":10,"descricao":"Tentativas maximas de follow-up."},
  {"chave":"fidelizacao.dias_sem_contato","valor":"30","unidade":"dias","tipo":"INT","valor_min":1,"valor_max":365,"descricao":"Dias sem contato para reengajamento."},
  {"chave":"ia.transferir_apos_mensagens","valor":"8","unidade":"mensagens","tipo":"INT","valor_min":1,"valor_max":50,"descricao":"Mensagens antes de sugerir transferencia."},
  {"chave":"ia.resumo.a_cada_mensagens","valor":"20","unidade":"mensagens","tipo":"INT","valor_min":5,"valor_max":200,"descricao":"Intervalo para resumo por IA."},
  {"chave":"atendimento.finalizar_apos_horas","valor":"48","unidade":"horas","tipo":"INT","valor_min":1,"valor_max":720,"descricao":"Inatividade para finalizar atendimento."},
  {"chave":"automacao.habilitada","valor":"true","unidade":null,"tipo":"BOOLEAN","valor_min":null,"valor_max":null,"descricao":"Liga a Automacao."},
  {"chave":"anexo.tamanho_maximo_imagem_mb","valor":"5","unidade":"MB","tipo":"INT","valor_min":1,"valor_max":5,"descricao":"Tamanho maximo de imagem; conferir Meta."},
  {"chave":"anexo.tamanho_maximo_audio_mb","valor":"16","unidade":"MB","tipo":"INT","valor_min":1,"valor_max":16,"descricao":"Tamanho maximo de audio; conferir Meta."},
