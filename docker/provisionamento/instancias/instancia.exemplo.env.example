# Copie para um arquivo local ignorado pelo Git e preencha com os dados do filho.
# Nao use nomes, tags, mensagens ou credenciais de outro cliente.
SYNAPSE_DB_NAME='nome_do_banco'
SYNAPSE_DB_USER='usuario_da_aplicacao'

SYNAPSE_ADMIN_NOME='Nome do administrador'
SYNAPSE_ADMIN_EMAIL='admin@cliente.exemplo'
# Gere no terminal conforme o README; nunca cole senha em texto.
SYNAPSE_ADMIN_BCRYPT_HASH=''

# Mesmo Phone Number ID numerico e provedor usados pelo backend no deploy. Nao
# informe o telefone exibido nem o WABA ID. O token nao entra no provisionamento:
# o banco recebe somente env://WHATSAPP_TOKEN.
WHATSAPP_NUMERO='1307417749115229'
TELEFONE_DDI_PADRAO='55'
WHATSAPP_PROVEDOR='meta-cloud'

# Lista livre: cada instancia define quantidade, nomes, ordem, cor e resultado.
# No maximo uma etapa pode ser GANHO; nomes nao carregam significado no codigo.
SYNAPSE_ETAPAS_JSON='[{"nome":"Etapa inicial","ordem":1,"cor_visual":"#64748B","resultado":"EM_ANDAMENTO"},{"nome":"Concluido","ordem":2,"cor_visual":"#22C55E","resultado":"GANHO"},{"nome":"Perdido","ordem":3,"cor_visual":"#EF4444","resultado":"PERDIDO"}]'
SYNAPSE_TAGS_JSON='[{"nome":"Tag inicial","cor":"#64748B","icone":"tag"}]'

# Valores de exemplo genericos. Os limites 5/16/100 MB sao os valores atuais
# usados no seed; confira a documentacao da Meta antes de producao.
SYNAPSE_AUTOMACAO_JSON='[
  {"chave":"followup.primeiro.minutos","valor":"15","unidade":"minutos","tipo":"INT","valor_min":1,"valor_max":1440,"descricao":"Primeiro follow-up automatico."},
